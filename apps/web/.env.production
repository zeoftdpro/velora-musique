# Build de production : l'API est relayée par Netlify sous /api (voir public/_redirects).
# Même origine que le site : pas de CORS, cookie de session « first-party » (indispensable sur Safari / iOS).
VITE_API_URL=/api

# Installateur Windows : dernière release du dépôt public liweyzfilalo/velora-app (fichier « Velora-Setup.exe »).
VITE_DESKTOP_DOWNLOAD_URL=https://github.com/liweyzfilalo/velora-app/releases/latest/download/Velora-Setup.exe
