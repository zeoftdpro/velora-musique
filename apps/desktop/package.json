{
  "name": "@velora/desktop",
  "productName": "Velora Musique",
  "version": "0.2.1",
  "private": true,
  "description": "Velora pour Windows : l'application web dans une fenêtre dédiée, avec installateur .exe",
  "author": "Velora",
  "main": "main.cjs",
  "veloraAppUrl": "https://velora-musique.netlify.app",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/dist.cjs"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.velora.desktop",
    "productName": "Velora Musique",
    "extraMetadata": { "name": "velora-musique" },
    "electronVersion": "43.7.7",
    "npmRebuild": false,
    "files": ["main.cjs", "preload.cjs", "offline.html", "build/icon.png", "package.json"],
    "directories": { "output": "release", "buildResources": "build" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Velora Musique",
      "uninstallDisplayName": "Velora Musique",
      "artifactName": "Velora-Setup-${version}.${ext}"
    }
  }
}
