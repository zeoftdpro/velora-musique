{
  "name": "@velora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:start": "tsx src/scripts/db-dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "demo:generate": "tsx src/scripts/generate-demo.ts",
    "search:reindex": "tsx src/scripts/reindex.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/cloudfront-signer": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ffmpeg-static": "^5.3.0",
    "meilisearch": "^0.62.0",
    "mime-types": "^3.0.2",
    "music-metadata": "^12.2.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "16.13.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
