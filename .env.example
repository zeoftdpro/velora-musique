# --- API ---
API_PORT=4000
# URL publique de l'API (utilisée dans les playlists HLS générées)
PUBLIC_API_URL=http://localhost:4000
# Origine(s) autorisée(s) en CORS, séparées par des virgules
WEB_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-with-a-long-random-string
# Durée de vie du jeton d'accès (secondes) et du jeton de rafraîchissement (jours)
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# --- PostgreSQL ---
DATABASE_URL=postgres://velora:velora@localhost:5432/velora

# --- Recherche (laisser MEILI_HOST vide pour basculer sur une recherche PostgreSQL) ---
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=velora-dev-master-key

# --- Stockage objet ---
# "s3" (AWS S3, Cloudflare R2, MinIO) ou "local" (dossier disque servi par l'API avec des URL signées HMAC)
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=velora
S3_ACCESS_KEY_ID=velora
S3_SECRET_ACCESS_KEY=velora-dev-secret
S3_FORCE_PATH_STYLE=true
# Base publique des pochettes (bucket public, CDN…). Vide = URL signées.
PUBLIC_ASSETS_URL=http://localhost:9000/velora

# --- CloudFront (optionnel, production) ---
# Si renseignés, les segments HLS sont signés via CloudFront au lieu d'URL pré-signées S3.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# Validité des URL de streaming signées (secondes)
STREAM_URL_TTL_SECONDS=14400

# --- Ingestion ---
# Chemin vers ffmpeg (vide = binaire fourni par ffmpeg-static)
FFMPEG_PATH=

# --- Jamendo (catalogue de musique libre, morceaux complets) ---
# client_id gratuit : https://devportal.jamendo.com/  (vide = recherche limitée au catalogue local)
JAMENDO_CLIENT_ID=

# --- YouTube (recherche via YouTube Data API v3, lecture via le lecteur YouTube officiel intégré) ---
# Clé API : https://console.cloud.google.com/apis/library/youtube.googleapis.com  (vide = désactivé)
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=FR
